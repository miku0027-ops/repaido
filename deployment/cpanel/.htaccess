# Website files only. The authenticated APIs remain on Cloud Run.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Preserve certificate validation while denying other hidden files.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Missing assets and release metadata must return 404, not the SPA HTML.
  RewriteRule ^(?:assets/|.*\.(?:js|mjs|css|json|map|png|jpe?g|svg|webp|ico|woff2?|ttf|apk|pdf)$) - [L,NC]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://api.razorpay.com https://checkout.razorpay.com; upgrade-insecure-requests"
  <FilesMatch "\.(?:css|js|mjs|png|jpe?g|svg|webp|ico|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(?:css|js|mjs|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(?:index\.html|build-info\.json|repaidians-work-push-sw\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
